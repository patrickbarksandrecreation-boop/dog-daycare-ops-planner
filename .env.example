# Public client settings. NEVER use a service_role or secret key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY
# Without valid settings, the app offers an explicit, in-memory demo.
# Set both values for cloud use, including in Netlify's build environment; rebuild after changes.
# Workspace access comes from staff_profiles, never from browser environment variables.

# Server-only AI sync: configure OPENAI_API_KEY in production Functions and the
# trusted session-setup environment. Never prefix this secret with VITE_.
